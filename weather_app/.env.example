# Both are optional. With neither set, the app runs fully offline using
# deterministic mock weather data (great for trying the app out).
#
# KMA_SERVICE_KEY: 기상청 공공데이터포털 인증키
#   1) https://www.data.go.kr 가입 후 로그인
#   2) "기상청_단기예보 조회서비스" 검색 -> 활용신청 (승인은 보통 즉시~1일)
#   3) "한국환경공단_에어코리아_대기오염정보" 도 같이 활용신청하면 미세먼지까지 표시됩니다
#   4) 마이페이지 > 개발계정 에서 발급된 "일반 인증키(Decoding)" 를 아래에 입력
KMA_SERVICE_KEY=

# ACCUWEATHER_API_KEY: AccuWeather API key
#   1) https://developer.accuweather.com 가입
#   2) My Apps > Add a new App (Limited Trial 로도 충분) -> API Key 발급
#   무료 티어는 하루 50 콜로 제한되어 있어 서버에서 5분 캐시를 적용합니다.
ACCUWEATHER_API_KEY=

# Which provider to prefer when both keys are set: accuweather | kma
# (leave blank to auto-pick: accuweather > kma > mock)
DEFAULT_WEATHER_PROVIDER=

PORT=8080

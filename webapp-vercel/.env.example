# Upstash Redis — provision from the Vercel dashboard (Storage tab → Upstash Redis,
# or upstash.com directly). Connecting it to this project via the Vercel integration
# fills these in automatically; only set them by hand for local `next dev`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the /api/cron endpoint. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` when the env var is set on the project — set
# any random string here and in the Vercel project settings so nobody else can trigger
# autonomous trading cycles by hitting the URL directly.
CRON_SECRET=

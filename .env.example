# Optional: without this the system runs fully offline using DummyLLMClient,
# which returns deterministic stub text instead of real narratives.
ANTHROPIC_API_KEY=

TRADING_AGENT_MODEL=claude-sonnet-5
TRADING_AGENT_STARTING_EQUITY=10000000
TRADING_AGENT_MEMORY_PATH=trading_agent_memory.json

# Optional: enable the Kronos price-forecasting analyst. Requires Kronos
# to be installed separately (not on PyPI) — see README.md's Kronos section.
TRADING_AGENT_KRONOS_ENABLED=false
TRADING_AGENT_KRONOS_MODEL=NeoQuasar/Kronos-small
TRADING_AGENT_KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
TRADING_AGENT_KRONOS_MAX_CONTEXT=512
TRADING_AGENT_KRONOS_DEVICE=cpu
TRADING_AGENT_KRONOS_PRED_LEN=10
TRADING_AGENT_KRONOS_SAMPLES=5
